# NavGuard IL — ESP32-S3 project defaults.
CONFIG_IDF_TARGET="esp32s3"

# --- Flash / partitions: dual OTA (A/B) on 8MB flash ---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_TWO_OTA=y

# --- BLE: NimBLE host, peripheral only ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# --- FreeRTOS tick at 1kHz so 1-3ms task periods schedule cleanly ---
CONFIG_FREERTOS_HZ=1000

# --- OTA over HTTPS ---
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# --- Main task stack headroom ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
